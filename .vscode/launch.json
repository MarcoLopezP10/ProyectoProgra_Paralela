        "--seed",
        "42",
        "--n-particles",
        "120",
        "--max-iters",
        "600"
      ]
    }
  ],
  "inputs": [
    {
      "id": "singleObjective",
      "type": "pickString",
      "description": "Objective function for scripts.run_pso",
      "default": "sphere",
      "options": [
        "sphere",
        "ackley",
        "rosenbrock",
        "rastrigin"
      ]
    },
    {
      "id": "singleDim",
      "type": "promptString",
      "description": "Dimension for scripts.run_pso",
      "default": "2"
    },
    {
      "id": "singleSeed",
      "type": "promptString",
      "description": "Seed for scripts.run_pso",
      "default": "42"
    },
    {
      "id": "vizObjective",
      "type": "pickString",
      "description": "Objective function for scripts.make_viz",
      "default": "sphere",
      "options": [
        "sphere",
        "ackley",
        "rosenbrock",
        "rastrigin"
      ]
    },
    {
      "id": "vizDim",
      "type": "pickString",
      "description": "Dimension for scripts.make_viz",
      "default": "2",
      "options": [
        "2",
        "3"
      ]
    },
    {
      "id": "vizSeed",
      "type": "promptString",
      "description": "Seed for scripts.make_viz",
      "default": "42"
    },
    {
      "id": "vizFormat",
      "type": "pickString",
      "description": "Output format for scripts.make_viz",
      "default": "gif",
      "options": [
        "gif",
        "mp4"
      ]
    },
    {
      "id": "edlCase",
      "type": "pickString",
      "description": "EDL case for scripts.run_edl",
      "default": "cases/edl_case_3u.json",
      "options": [
        "cases/edl_case_3u.json",
        "cases/edl_case_6u.json",
        "cases/edl_case_13u.json",
        "cases/edl_case_40u.json"
      ]
    },
    {
      "id": "edlCaseName",
      "type": "pickString",
      "description": "Saved EDL case_name for scripts.analyze_edl",
      "default": "edl_3u_demo",
      "options": [
        "edl_3u_demo",
        "edl_6u_vpe_losses",
        "edl_13u_vpe",
        "edl_40u_vpe"
      ]
    },
    {
      "id": "edlVariant",
      "type": "pickString",
      "description": "EDL variant for scripts.run_edl",
      "default": "edl_1",
      "options": [
        "edl_1",
        "edl_2",
        "edl_3",
        "edl_4"
      ]
    },
    {
      "id": "edlSeed",
      "type": "promptString",
      "description": "Seed for scripts.run_edl",
      "default": "42"
    }
  ]
}
