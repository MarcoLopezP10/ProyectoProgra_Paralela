{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PSO: Active script in editor",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "purpose": [
        "debug-in-terminal"
      ]
    },
    {
      "name": "PSO: Run single (default)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_pso",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PSO: Run single (choose objective, dim, seed)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_pso",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--objective",
        "${input:singleObjective}",
        "--dim",
        "${input:singleDim}",
        "--seed",
        "${input:singleSeed}"
      ]
    },
    {
      "name": "PSO: Run single (enter args)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_pso",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": "${command:pickArgs}"
    },
    {
      "name": "PSO: Run benchmarks (quick)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_benchmarks",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--dims",
        "2",
        "--seeds",
        "42",
        "--no-grid-search"
      ]
    },
    {
      "name": "PSO: Run benchmarks (default)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_benchmarks",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PSO: Run benchmarks (enter args)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_benchmarks",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": "${command:pickArgs}"
    },
    {
      "name": "PSO: Run grid search (quick)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_grid_search",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--objective",
        "sphere",
        "--dims",
        "2",
        "--seeds",
        "42",
        "7",
        "--max-iters",
        "100"
      ]
    },
    {
      "name": "PSO: Run grid search (default)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_grid_search",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PSO: Run grid search (enter args)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_grid_search",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": "${command:pickArgs}"
    },
    {
      "name": "PSO: Make visualization (default)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.make_viz",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PSO: Make visualization (choose values)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.make_viz",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--objective",
        "${input:vizObjective}",
        "--dim",
        "${input:vizDim}",
        "--seed",
        "${input:vizSeed}",
        "--format",
        "${input:vizFormat}"
      ]
    },
    {
      "name": "PSO: Make visualization (enter args)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.make_viz",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": "${command:pickArgs}"
    },
    {
      "name": "PSO: Analyze results (default)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.analyze_results",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PSO: Analyze results (enter args)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.analyze_results",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": "${command:pickArgs}"
    },
    {
      "name": "PSO: Clean outputs",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.clean_outputs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PSO: Clean outputs (remove logs too)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.clean_outputs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--remove-logs"
      ]
    },
    {
      "name": "EDL: Custom Case (all valid variants)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 1
      },
      "args": [
        "--case",
        "${input:edlCase}",
        "--seed",
        "${input:edlSeed}"
      ]
    },
    {
      "name": "EDL: Custom Case (single variant)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 2
      },
      "args": [
        "--case",
        "${input:edlCase}",
        "--variant",
        "${input:edlVariant}",
        "--seed",
        "${input:edlSeed}"
      ]
    },
    {
      "name": "EDL: Regenerate Reports",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.analyze_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 3
      },
      "args": [
        "--case",
        "${input:edlCaseName}",
        "--seed",
        "${input:edlSeed}"
      ]
    },
    {
      "name": "EDL: 3U Validation (quick)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 4
      },
      "args": [
        "--case",
        "cases/edl_case_3u.json",
        "--seed",
        "42",
        "--n-particles",
        "20",
        "--max-iters",
        "50",
        "--no-plots"
      ]
    },
    {
      "name": "EDL: 3U Final Run",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 5
      },
      "args": [
        "--case",
        "cases/edl_case_3u.json",
        "--seed",
        "42",
        "--n-particles",
        "60",
        "--max-iters",
        "300"
      ]
    },
    {
      "name": "EDL: 6U Validation (quick)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 6
      },
      "args": [
        "--case",
        "cases/edl_case_6u.json",
        "--seed",
        "42",
        "--n-particles",
        "20",
        "--max-iters",
        "50",
        "--no-plots"
      ]
    },
    {
      "name": "EDL: 6U Final Run",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 7
      },
      "args": [
        "--case",
        "cases/edl_case_6u.json",
        "--seed",
        "42",
        "--n-particles",
        "80",
        "--max-iters",
        "400"
      ]
    },
    {
      "name": "EDL: 13U Validation (quick)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 8
      },
      "args": [
        "--case",
        "cases/edl_case_13u.json",
        "--variant",
        "edl_1",
        "edl_2",
        "--seed",
        "42",
        "--n-particles",
        "20",
        "--max-iters",
        "30",
        "--no-plots"
      ]
    },
    {
      "name": "EDL: 13U Final Run",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 9
      },
      "args": [
        "--case",
        "cases/edl_case_13u.json",
        "--variant",
        "edl_1",
        "edl_2",
        "--seed",
        "42",
        "--n-particles",
        "100",
        "--max-iters",
        "500"
      ]
    },
    {
      "name": "EDL: 40U Validation (quick)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 10
      },
      "args": [
        "--case",
        "cases/edl_case_40u.json",
        "--variant",
        "edl_1",
        "edl_2",
        "--seed",
        "42",
        "--n-particles",
        "20",
        "--max-iters",
        "20",
        "--no-plots"
      ]
    },
    {
      "name": "EDL: 40U Final Run",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/local/bin/python3",
      "module": "scripts.run_edl",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "group": "EDL",
        "order": 11
      },
      "args": [
        "--case",
        "cases/edl_case_40u.json",
        "--variant",
        "edl_1",
